<script>
const fishes = [fishA, fishB, Sub];
function randomizeFish(fish, i) {
  const top = Math.random() * 60 + 20;
  const duration = 10 + Math.random() * 12;
  const dir = Math.random() > 0.5 ? 'swim1' : 'swim2';
  fish.style.top = top + '%';
  fish.style.animation = `${dir} ${duration}s linear infinite`;
}
fishes.forEach((fish, i) => {
  randomizeFish(fish, i);
  fish.addEventListener('animationiteration', () => randomizeFish(fish, i));
});
</script>
