<style>
  :root {
    --deep1: #001018;
    --deep2: #00212c;
    --deep3: #003447;
    --caustic-color: rgba(150, 200, 255, 0.1);
  }
  html, body {
    height: 100%;
    margin: 0;
    background: linear-gradient(180deg, var(--deep3), var(--deep2) 50%, var(--deep1));
    overflow: hidden;
  }
  .stage {
    position: relative;
    width: 100vw;
    height: 100vh;
  }
  .light-beam {
    position: absolute;
    top: 0;
    width: 4px;
    height: 100%;
    rotate: 30deg;
    background: linear-gradient(180deg, rgba(120, 200, 255, 0.3), rgba(0, 0, 0, 0));
    opacity: 0.18;
    filter: blur(8px);
    animation: beamDynamic 20s ease-in-out infinite, beamColorShift 25s ease-in-out infinite;
    mix-blend-mode: screen;
  }
  @keyframes beamDynamic {
    0% { transform: translateY(0) translateX(0) scaleY(1) scaleX(1); opacity: 0.15; width: 4px; }
    20% { transform: translateY(10px) translateX(10px) scaleY(1.05) scaleX(1.2); opacity: 0.22; width: 6px; }
    40% { transform: translateY(20px) translateX(-10px) scaleY(1.1) scaleX(0.9); opacity: 0.25; width: 3px; }
    60% { transform: translateY(15px) translateX(15px) scaleY(1.08) scaleX(1.1); opacity: 0.2; width: 5px; }
    80% { transform: translateY(25px) translateX(-15px) scaleY(1.15) scaleX(1.3); opacity: 0.24; width: 7px; }
    100% { transform: translateY(0) translateX(0) scaleY(1) scaleX(1); opacity: 0.15; width: 4px; }
  }
  @keyframes beamColorShift {
    0% { background: linear-gradient(180deg, rgba(120, 200, 255, 0.3), rgba(0, 0, 0, 0)); }
    25% { background: linear-gradient(180deg, rgba(100, 240, 255, 0.35), rgba(0, 0, 0, 0)); }
    50% { background: linear-gradient(180deg, rgba(80, 210, 200, 0.3), rgba(0, 0, 0, 0)); }
    75% { background: linear-gradient(180deg, rgba(60, 170, 190, 0.3), rgba(0, 0, 0, 0)); }
    100% { background: linear-gradient(180deg, rgba(120, 200, 255, 0.3), rgba(0, 0, 0, 0)); }
  }
  .caustics {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 30% 30%, var(--caustic-color) 0%, transparent 15%), radial-gradient(circle at 70% 60%, var(--caustic-color) 0%, transparent 20%);
    background-size: 200% 200%;
    animation: drift 14s linear infinite;
    mix-blend-mode: screen;
    filter: blur(5px);
  }
  @keyframes drift {
    0% { background-position: 0% 0%; }
    50% { background-position: 50% 30%; }
    100% { background-position: 0% 0%; }
  }
  .fish {
    position: absolute;
    width: 90px;
    opacity: 0.75;
    filter: brightness(0.4);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  svg.fish path {
    fill: #010101;
  }
  @keyframes swim1 { 0% { transform: translateX(-15vw) scaleX(-1); } 100% { transform: translateX(115vw) scaleX(-1); } }
  @keyframes swim2 { 0% { transform: translateX(115vw); } 100% { transform: translateX(-15vw); } }
  .image-grid {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    grid-template-columns: repeat(2, 180px);
    grid-template-rows: repeat(2, 180px);
    gap: 50px;
    z-index: 5;
  }
  .image-grid img {
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 10px;
    opacity: 0.85;
    animation: floatImg 10s ease-in-out infinite alternate;
    filter: brightness(0.9);
  }
  @keyframes floatImg {
    0% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-8px) scale(1.03); }
    100% { transform: translateY(0) scale(1); }
  }
</style>
  <div class="stage">
    <!-- Color-shifting dynamic light beams -->
    <div class="light-beam" style="left:10%; animation-delay:0s;"></div>
    <div class="light-beam" style="left:30%; animation-delay:3s;"></div>
    <div class="light-beam" style="left:55%; animation-delay:6s;"></div>
    <div class="light-beam" style="left:75%; animation-delay:9s;"></div>

    <div class="caustics"></div>

    <div class="image-grid">
      <% @img.each do |i| %>
        <img src="<%= '/'+i %>"/>
      <% end %>
    </div>

